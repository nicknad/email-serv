# Logging filter for the `tracing` subscriber (e.g. email-serv=debug,tower_http=debug)
RUST_LOG=email-serv=debug

# Directory for daily rolling JSON log files
LOG_DIR=/var/log/email-serv

### DATABASE
# Connection string used by the application at runtime
DB_CONN=sqlite://example.db
# Used only by `cargo sqlx` for compile-time query checking / the offline cache
DATABASE_URL=sqlite://example.db

PORT=5000

# Generate your own with: openssl rand -hex 32
BLAKE3_KEY=327da54c32bbda6f1b56c2e248620d31324b6bf5664fc31ab4d455f38787a5fa

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
EMAIL_FROM=noreply@example.com

# Admin API + public links
ADMIN_API_KEY=supersecretadminauthkey
SITE_URL=http://localhost:3000
